# No Reddit API key needed — uses public JSON endpoints

# OpenAI API (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Google Gemini API (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Local XTTS v2 TTS server
TTS_SERVER_URL=http://localhost:8321

# Path to reference voice WAV for XTTS v2 voice cloning
TTS_REFERENCE_VOICE=./tts/voices/reference.wav

# Output directory for generated content
OUTPUT_DIR=./output
